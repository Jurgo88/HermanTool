# All variables are NUXT_-prefixed so Nuxt's runtimeConfig env mapping
# picks them up automatically, with no manual process.env wiring in
# nuxt.config.ts (D-31).

# Database — direct Postgres connection (D-25, D-31, R-09). Use the
# Transaction Pooler connection string from the Supabase dashboard, not
# the direct :5432 connection (Part 4 §14.2).
NUXT_DATABASE_URL=

# Supabase Auth only (D-22) — never used to reach the database (D-25).
NUXT_SUPABASE_URL=
NUXT_SUPABASE_ANON_KEY=
NUXT_SUPABASE_SERVICE_ROLE_KEY=   # server-only, never client

# Cloudflare R2
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_ENDPOINT=
NUXT_R2_BUCKET_EVIDENCE=
NUXT_R2_BUCKET_CONDITIONS=

# D-32, issue #72/IR-04: nightly backup (scripts/backup-and-record.mjs,
# .github/workflows/nightly-backup.yml) is NOT part of the running app
# and reads its own environment in GitHub Actions, not from this file —
# no NUXT_ vars here for it. Six GitHub Actions secrets/vars to set once
# (not read by this app at runtime): SUPABASE_DB_DIRECT_URL (secret —
# the DIRECT/session-mode connection string, NOT the pooler string
# above), R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY (secrets, same values
# as NUXT_R2_ACCESS_KEY_ID/NUXT_R2_SECRET_ACCESS_KEY above), R2_ENDPOINT,
# R2_BUCKET_CONDITIONS (vars, same values as NUXT_R2_ENDPOINT/
# NUXT_R2_BUCKET_CONDITIONS above), and R2_BUCKET_BACKUPS (var — a NEW
# bucket, not one of the two above; create it before enabling the
# schedule). See the workflow file's own header for the full reasoning.

# Stripe (Tenant's own account, D-26, D-31 — rotation is a two-party event)
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=

# Site origin, used server-side only to build Stripe's success/cancel
# redirect URLs (never a client-supplied value — open-redirect risk).
NUXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Resend (D-28)
NUXT_RESEND_API_KEY=
NUXT_NOTIFICATION_FROM_ADDRESS=   # must be a Resend-verified sender for the Tenant's own domain

# Sentry (D-29, NFR-08, NFR-14; issue #73/IR-05). SDK-level scrubbing
# (sendDefaultPii: false, beforeSend dropping IdentityEvidence routes)
# is already wired in sentry.server.config.ts / sentry.client.config.ts
# and needs no further setup here. Two things this env var alone does
# NOT get you, and which must be set by hand in the Sentry project
# (Settings):
#   - EU data residency: choose an EU-region org/project when creating
#     it (R-13) — the DSN's ingest host reflects the choice made at
#     creation time, not something this app can change afterwards.
#   - Per-key rate limiting (Settings -> Client Keys): caps one bad
#     deploy from spending the month's 5,000-event quota in an hour.
# Optional: SENTRY_AUTH_TOKEN (build-time only, not runtimeConfig) for
# source map upload — unset is fine, the build skips upload with a
# warning rather than failing.
NUXT_SENTRY_DSN=

# Internal job secret (D-25 §14.2) — shared between this server and the
# GitHub Actions workflow that schedules the expiry sweep. Not an
# Operator credential; generate a long random value and set the same one
# in the GitHub repo secret SWEEP_JOB_SECRET.
NUXT_INTERNAL_JOB_SECRET=
