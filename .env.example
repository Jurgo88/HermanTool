# All variables are NUXT_-prefixed so Nuxt's runtimeConfig env mapping
# picks them up automatically, with no manual process.env wiring in
# nuxt.config.ts (D-31).

# Database — direct Postgres connection (D-25, D-31, R-09). Use the
# Transaction Pooler connection string from the Supabase dashboard, not
# the direct :5432 connection (Part 4 §14.2).
NUXT_DATABASE_URL=

# Supabase Auth only (D-22) — never used to reach the database (D-25).
NUXT_SUPABASE_URL=
NUXT_SUPABASE_ANON_KEY=
NUXT_SUPABASE_SERVICE_ROLE_KEY=   # server-only, never client

# Cloudflare R2
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_ENDPOINT=
NUXT_R2_BUCKET_EVIDENCE=
NUXT_R2_BUCKET_CONDITIONS=

# Stripe (Tenant's account)
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=

# Resend
NUXT_RESEND_API_KEY=

# Sentry
NUXT_SENTRY_DSN=

# Internal job secret (D-25 §14.2) — shared between this server and the
# GitHub Actions workflow that schedules the expiry sweep. Not an
# Operator credential; generate a long random value and set the same one
# in the GitHub repo secret SWEEP_JOB_SECRET.
NUXT_INTERNAL_JOB_SECRET=
