# All variables are NUXT_-prefixed so Nuxt's runtimeConfig env mapping
# picks them up automatically, with no manual process.env wiring in
# nuxt.config.ts (D-31).

# Supabase
NUXT_SUPABASE_URL=
NUXT_SUPABASE_ANON_KEY=
NUXT_SUPABASE_SERVICE_ROLE_KEY=   # server-only, never client

# Cloudflare R2
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_ENDPOINT=
NUXT_R2_BUCKET_EVIDENCE=
NUXT_R2_BUCKET_CONDITIONS=

# Stripe (Tenant's account)
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=

# Resend
NUXT_RESEND_API_KEY=

# Sentry
NUXT_SENTRY_DSN=
